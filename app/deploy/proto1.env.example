# /opt/proto1/proto1.env 로 복사해 씁니다. 두 서비스가 함께 읽습니다.
# 키 값을 이 파일에 쓰지 않습니다. 키 파일 경로는 proto1-relay.service의 LoadCredential에만 적습니다.

# 릴레이가 믿을 바로 앞 프록시의 소켓 주소입니다.
# 릴레이 앞은 항상 같은 서버의 web-server.mjs이므로 127.0.0.1로 둡니다.
TRUSTED_PROXY_ADDRESS=127.0.0.1

# 터널이 덮어쓰는 실제 접속 IP 헤더입니다. 공개 경로에 맞는 값 하나를 적습니다.
# 틀린 값을 쓰면 방문자가 헤더를 위조해 IP당 한도를 피할 수 있습니다.
# 비워 두면 릴레이가 TRUSTED_PROXY_INVALID를 출력하고 시작하지 않습니다.
#   Cloudflare Tunnel: cf-connecting-ip
#   Tailscale Funnel: x-forwarded-for
TRUSTED_PROXY_HEADER=x-forwarded-for

# 웹 서버가 /plan을 넘길 릴레이 주소입니다.
RELAY_URL=http://127.0.0.1:18787

# 그 밖의 변수
# PORT: 각 서비스 파일에 있습니다. 릴레이 18787, 웹 14173입니다.
# ANTHROPIC_API_KEY_FILE: proto1-relay.service가 systemd 자격 증명 경로로 정합니다.
# WEB_ROOT: 정적 파일 폴더입니다. 기본값은 web-server.mjs 옆의 web입니다.
